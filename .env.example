# Telegram Bot Token (@BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Super Admin (Loyiha egasi / Dasturchi) Telegram User IDs (comma-separated)
SUPER_ADMIN_IDS=5649321700

# Admin / Staff Telegram User IDs (comma-separated, optional :Name label, e.g. 5649321700:Asad; leave empty to allow private chat usage)
ADMIN_IDS=

# Developer / Support contact shown in subscription renewal messages
OWNER_CONTACT=@your_username

# Monthly SaaS subscription defaults
DEFAULT_MONTHLY_PRICE=400000
DEFAULT_TRIAL_DAYS=30

# Database URL (SQLite for quick start, PostgreSQL for production)
# Docker Compose PostgreSQL example: postgresql+asyncpg://norin:strong_password@norin-postgres:5432/norin_db
DATABASE_URL=sqlite+aiosqlite:///./data/norin_bot.db

# Docker Compose PostgreSQL credentials (when using docker-compose.yml)
POSTGRES_USER=norin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=norin_db

# Gemini AI API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

TIMEZONE=Asia/Tashkent
